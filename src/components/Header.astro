---
import { LOGO_PROVISORIA } from '../scripts/splash/logo';
---

<header class="h-16 border-b border-parede bg-papel">
	<div class="mx-auto flex h-full max-w-5xl items-center px-6">
		<a href="/" class="inline-flex items-center gap-3 text-carbono no-underline">
			<img
				src={LOGO_PROVISORIA.src}
				width={40}
				height={40}
				alt="Logo WhiteRoom"
				data-splash-alvo
				class="h-10 w-10 shrink-0 select-none"
				decoding="sync"
			/>
			<span class="text-lg font-semibold tracking-tight">WhiteRoom</span>
		</a>
	</div>
</header>
