---
import { LOGO_PROVISORIA } from '../scripts/splash/logo';
---

<div
	id="wr-splash"
	data-splash-overlay
	aria-hidden="true"
	class="fixed inset-0 z-9999 select-none"
>
	<div data-splash-fundo class="absolute inset-0 bg-papel"></div>
	<img
		src={LOGO_PROVISORIA.src}
		width={LOGO_PROVISORIA.width}
		height={LOGO_PROVISORIA.height}
		alt=""
		data-splash-logo
		class="pointer-events-none relative z-10 block h-[55vmin] w-[55vmin] object-contain will-change-transform"
		decoding="sync"
		loading="eager"
	/>
	<canvas
		data-splash-canvas
		class="pointer-events-none absolute inset-0 z-20 block h-full w-full opacity-0"
	></canvas>
</div>

<script>
	import { iniciarSplash } from '../scripts/splash/controlador';
	iniciarSplash();
</script>
