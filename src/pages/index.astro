---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Splash from '../components/Splash.astro';
import Base from '../layouts/Base.astro';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base titulo="WhiteRoom Software House" descricao="Portfólio da WhiteRoom Software House.">
	<script is:inline slot="head">
		(() => {
			const root = document.documentElement;
			const params = new URLSearchParams(window.location.search);
			if (params.has('debug')) {
				root.classList.add('splash-ativa', 'splash-debug');
				if (params.get('debug') === 'captura') {
					root.classList.add('splash-captura');
				}
				return;
			}

			// Restauração pelo histórico (bfcache) preserva a página como estava, sem repetir a splash
			window.addEventListener('pageshow', (event) => {
				if (event.persisted) {
					root.classList.remove('splash-ativa', 'splash-reduzida', 'splash-reduzida-pronta');
					document.querySelector('[data-splash-overlay]')?.remove();
				}
			});

			window.__wrSplashHeadInicio = performance.now();
			root.classList.add('splash-ativa');

			if (
				typeof window.matchMedia === 'function' &&
				window.matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				root.classList.add('splash-reduzida');
			}

			// Rede de segurança compatível com o limite de 10 s de carregamento: só age se o módulo do controlador nunca rodar
			window.setTimeout(() => {
				if (window.__wrSplashIniciada !== true) {
					root.classList.remove('splash-ativa', 'splash-reduzida', 'splash-reduzida-pronta');
					document.querySelector('[data-splash-overlay]')?.remove();
				}
			}, 12000);
		})();
	</script>

	<Splash />

	<main class="mx-auto max-w-5xl px-6 py-24">
		<h1 class="text-5xl font-bold">WhiteRoom</h1>
		<p class="mt-2 text-ocre">Software House</p>

		<ul class="mt-16 grid gap-8 sm:grid-cols-2">
			{
				projetos.map(({ data }) => (
					<li>
						<a href={data.link} target="_blank" rel="noopener">
							<Image src={data.capa} alt={data.capaAlt} widths={[480, 960]} sizes="(min-width: 640px) 50vw, 100vw" />
							<h2 class="mt-4 text-xl font-semibold">{data.titulo}</h2>
						</a>
						<p>{data.resumo}</p>
					</li>
				))
			}
		</ul>
	</main>
</Base>
